# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# .env.local wird NIE eingecheckt.

# TMDB: https://www.themoviedb.org/settings/api
# Entweder "API-Schlüssel" (v3, 32 Zeichen) oder "API Read Access Token" (v4) eintragen.
TMDB_READ_TOKEN=

# Datenbank: supabase (Standard), mariadb, mysql, postgres oder sqlite
# Mail-Login gibt es nur mit supabase. Beim Self-Hosten treten alle einfach per QR-Code bei.
DATABASE=supabase

# Verbindung zur Datenbank (nicht nötig bei sqlite):
#  Supabase: Connect -> "Transaction pooler" -> URI kopieren, [YOUR-PASSWORD] durch das Datenbank-Passwort ersetzen
#  MariaDB:  mysql://cinemood:passwort@localhost:3306/cinemood
DATABASE_URL=

# Nur bei sqlite: Speicherort der Datenbank-Datei (Standard: data/cinemood.db)
# SQLITE_FILE=data/cinemood.db

# Nur bei supabase (für den Mail-Login): Project Settings -> API
SUPABASE_URL=
# Nur auf dem Server verwenden, niemals mit NEXT_PUBLIC_ prefixen!
SUPABASE_SERVICE_ROLE_KEY=

# Zufälliger langer Wert (z.B. `openssl rand -base64 32`), für Token-Hashes
APP_SECRET=

# Optional: weitere erlaubte Adressen (Komma-getrennt), z.B. für VS-Code-Port-Forwarding:
# ALLOWED_ORIGINS=https://*.devtunnels.ms
ALLOWED_ORIGINS=

# Self-Hosting ohne HTTPS (z. B. http://192.168.178.20:3000 im Heimnetz). Im Docker-Image schon gesetzt.
# ALLOW_HTTP=1

# Nur lokal (nie in Vercel): Testdaten statt TMDB, Login ohne echte Mails (Code ist immer 123456).
# TMDB_MOCK=1
# AUTH_MOCK=1
