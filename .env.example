# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# .env.local wird NIE eingecheckt.

# TMDB: https://www.themoviedb.org/settings/api
# Entweder "API-Schlüssel" (v3, 32 Zeichen) oder "API Read Access Token" (v4) eintragen.
TMDB_READ_TOKEN=

# Supabase: Project Settings -> API
SUPABASE_URL=
# Nur auf dem Server verwenden, niemals mit NEXT_PUBLIC_ prefixen!
SUPABASE_SERVICE_ROLE_KEY=

# Zufälliger langer Wert (z.B. `openssl rand -base64 32`), für Token-Hashes
APP_SECRET=
