<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="48dp"
        android:paddingEnd="96dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/gold"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/cream_dim"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/input_bg"
            android:hint="@string/settings_placeholder"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:padding="16dp"
            android:singleLine="true"
            android:textColor="@color/cream"
            android:textColorHint="@color/cream_dim"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save"
                style="@style/TvButton"
                android:text="@string/settings_save" />

            <Button
                android:id="@+id/reset"
                style="@style/TvButton"
                android:layout_marginStart="16dp"
                android:text="@string/settings_reset" />

            <Button
                android:id="@+id/cancel"
                style="@style/TvButton"
                android:layout_marginStart="16dp"
                android:text="@string/settings_cancel" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/reload"
                style="@style/TvButton"
                android:text="@string/settings_reload" />

            <Button
                android:id="@+id/check_update"
                style="@style/TvButton"
                android:layout_marginStart="16dp"
                android:text="@string/settings_check_update" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_keys"
            android:textColor="@color/cream_dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/cream_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
