<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <LinearLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_title"
            android:textColor="@color/cream"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="640dp"
            android:textColor="@color/cream_dim"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/error_retry"
                style="@style/TvButton"
                android:text="@string/retry" />

            <Button
                android:id="@+id/error_settings"
                style="@style/TvButton"
                android:layout_marginTop="12dp"
                android:text="@string/change_address" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>

    <!-- Navigationsleiste unten: Lobby, Watchlist, Train my Algorithm, Konto (runde Bubbles, Form in NavBar) -->
    <app.cinemood.handy.NavBar
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nav_lobby"
            style="@style/NavItem"
            android:drawableTop="@drawable/nav_bubble_lobby"
            android:text="@string/nav_lobby" />

        <TextView
            android:id="@+id/nav_watchlist"
            style="@style/NavItem"
            android:drawableTop="@drawable/nav_bubble_watchlist"
            android:text="@string/nav_watchlist" />

        <TextView
            android:id="@+id/nav_train"
            style="@style/NavItem"
            android:drawableTop="@drawable/nav_bubble_train"
            android:text="@string/nav_train" />

        <TextView
            android:id="@+id/nav_account"
            style="@style/NavItem"
            android:drawableTop="@drawable/nav_bubble_account"
            android:text="@string/nav_account" />
    </app.cinemood.handy.NavBar>
</LinearLayout>
